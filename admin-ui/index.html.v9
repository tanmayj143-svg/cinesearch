<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>CineSearch — Admin Console</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap');
:root{--v:#8b3dff;--violet:#a060ff;--pink:#ff4ec8;--bg:#0a0514;--surface:#120a20;--line:#2a1a38;--fg:#f3e8ff;--fg-dim:#b08dc8;--bad:#ff5c8a;--ok:#5ad18a}
*{box-sizing:border-box}
body{margin:0;background:linear-gradient(180deg,#0a0514 0%,#14082a 60%,#120a20 100%);min-height:100vh;color:var(--fg);font:14px/1.6 Inter,system-ui,sans-serif;padding:24px 20px}
h1{font-size:26px;font-weight:800;color:var(--pink);letter-spacing:-.03em;text-shadow:0 0 30px rgba(255,78,200,.35);margin:0 0 4px}
.sub{color:var(--fg-dim);font-size:12px;margin-bottom:22px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(420px,1fr));gap:18px;max-width:1400px;margin:auto}
.card{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:20px;box-shadow:0 10px 40px rgba(0,0,0,.45),inset 0 1px 0 rgba(255,255,255,.05);backdrop-filter:blur(6px)}
.card h2{color:var(--violet);font-size:15px;margin:0 0 14px;font-weight:700}
.card h2::before{content:'';display:inline-block;width:8px;height:8px;background:var(--pink);border-radius:50%;margin-right:10px;box-shadow:0 0 10px var(--pink);vertical-align:middle}
button{cursor:pointer;border:0;border-radius:10px;padding:9px 16px;font:600 13px Inter,sans-serif;background:linear-gradient(135deg,#8b3dff,#ff4ec8);color:#fff;box-shadow:0 4px 20px rgba(139,61,255,.35);transition:.15s}
button:hover{box-shadow:0 6px 30px rgba(255,78,200,.5);transform:translateY(-1px)}
button.ghost{background:transparent;color:var(--violet);border:1px solid #3a2055;box-shadow:none}
button.ghost:hover{border-color:var(--pink);color:var(--pink)}
button.tiny{padding:3px 10px;font-size:11px;border-radius:8px}
input,select{background:#0f0518;border:1px solid #3a2055;color:#fff;border-radius:10px;padding:8px 10px;font:inherit}
input:focus,select:focus{outline:none;border-color:var(--pink);box-shadow:0 0 0 3px rgba(255,78,200,.15)}
label{font-size:11px;color:var(--fg-dim);text-transform:uppercase;letter-spacing:.05em;font-weight:700;margin-bottom:4px;display:block}
.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
code{font-family:ui-monospace,monospace;font-size:12px;color:var(--pink);background:#1a0828;padding:2px 6px;border-radius:4px}
table{width:100%;border-collapse:collapse;font-size:12.5px}
th{color:var(--fg-dim);text-align:left;padding:6px 8px;border-bottom:1px solid var(--line);font-weight:700;text-transform:uppercase;font-size:10px;letter-spacing:.06em}
td{padding:7px 8px;border-bottom:1px solid rgba(255,255,255,.04);vertical-align:top}
.st-done{color:var(--ok)}.st-failed{color:var(--bad)}.st-active{color:var(--violet)}
.badge{display:inline-block;padding:2px 7px;border-radius:20px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;background:rgba(139,61,255,.15);color:var(--violet);border:1px solid rgba(139,61,255,.35)}
.badge.warn{background:rgba(255,92,138,.12);color:var(--bad);border-color:rgba(255,92,138,.35)}
.stat{font-weight:800;font-size:22px;letter-spacing:-.02em}
.stat-sub{font-size:11px;color:var(--fg-dim);margin-top:2px}
pre{white-space:pre-wrap;color:var(--bad);font-size:11px;margin:4px 0}
.pill{display:inline-block;background:rgba(160,96,255,.12);border:1px solid rgba(160,96,255,.3);color:var(--violet);border-radius:20px;padding:2px 9px;font-size:11px;margin:2px 4px 2px 0}
</style></head><body>
<h1>CineSearch <span style="font-weight:300;font-size:14px;color:var(--fg-dim);letter-spacing:.2em">ADMIN</span> <a href="ingest.html" style="font-size:11px;color:var(--pink);margin-left:12px;text-decoration:none;border:1px solid var(--pink);padding:3px 10px;border-radius:20px;float:right">Ingest →</a></h1>
<div class="sub">Cinematic search database · 192.168.1.35 · admin console</div>

<div class="grid">

  <div class="card">
    <h2>Overview</h2>
    <div class="row" style="gap:22px;margin-top:6px">
      <div><div class="stat" id="stat-files">—</div><div class="stat-sub">Files</div></div>
      <div><div class="stat" id="stat-shots">—</div><div class="stat-sub">Shots</div></div>
      <div><div class="stat" id="stat-utter">—</div><div class="stat-sub">Utterances</div></div>
      <div><div class="stat" id="stat-scenes">—</div><div class="stat-sub">Scenes</div></div>
      <div><div class="stat" id="stat-queue">—</div><div class="stat-sub">Pending</div></div>
      <div><div class="stat" id="stat-failed" style="color:var(--bad)">—</div><div class="stat-sub">Failed</div></div>
    </div>
    <div id="stat-extra" style="margin-top:12px"></div>
    <div id="stat-top" style="margin-top:6px"></div>
  </div>

  <div class="card">
    <h2>Worker</h2>
    <div id="wstate">Loading…</div>
    <div class="row" style="margin-top:10px">
      <button onclick="pauseWorker(true)">Pause</button>
      <button onclick="pauseWorker(false)">Resume</button>
      <button class="ghost" onclick="pollAll()">Refresh</button>
    </div>
    <div id="gpuinfo" style="margin-top:10px;font-size:12px;color:var(--fg-dim)"></div>
  </div>

  <div class="card">
    <h2>Model tier</h2>
    <select id="mtier" onchange="setTier(this.value)" style="width:100%"></select>
    <div style="margin-top:8px;font-size:12px;color:var(--fg-dim)" id="mtmsg"></div>
  </div>

  <div class="card">
    <h2>Simultaneous model residency</h2>
    <select id="residency" onchange="setResidency(this.value)" style="width:100%"></select>
    <div id="resmsg" style="margin-top:8px;font-size:12px;color:var(--fg-dim)"></div>
    <div style="margin-top:8px;font-size:11px;color:var(--fg-dim)">Profiles above 12&nbsp;GB need a bigger GPU; the worker refuses to start a stage whose residency estimate exceeds detected VRAM. Applies on the next queued job.</div>
  </div>

  <div class="card" style="grid-column:span 2">
    <h2>Ingest queue <span class="badge">live · 5s</span></h2>
    <table><thead><tr><th>#</th><th>File code</th><th>Prio</th><th>Status</th><th>Stages</th><th></th></tr></thead><tbody id="qbody"></tbody></table>
  </div>

  <div class="card" style="grid-column:span 2">
    <h2>Library</h2>
    <div class="row" style="margin-bottom:10px">
      <input id="libfilter" placeholder="Filter codes / paths…" style="flex:1" oninput="renderLibrary(this.value)">
      <button class="ghost" onclick="pollLibrary()">Refresh</button>
    </div>
    <table><thead><tr><th>Code</th><th>Path</th><th>Status</th><th>Duration</th><th>Size</th><th>Shots</th><th>Utterances</th><th></th></tr></thead><tbody id="libbody"></tbody></table>
  </div>

  <div class="card" style="grid-column:span 2">
    <h2>ID schemes</h2>
    <table><thead><tr><th>Name</th><th>Prefix</th><th>Pad</th><th>Next #</th><th>Rename on ingest</th><th>Default</th><th></th></tr></thead><tbody id="schbody"></tbody></table>
    <div class="row" style="margin-top:10px">
      <input id="sname" placeholder="new scheme name" style="flex:1;min-width:120px">
      <input id="sprefix" placeholder="prefix" value="SPOT" style="width:90px">
      <button class="tiny ghost" onclick="addScheme()">Add scheme</button>
    </div>
  </div>

</div>

<script>
const tiers=[
  {v:'tier_full',l:'Full — Qwen7B-VL + ShotVL3B + whisper-large-v3 (12GB)'},
  {v:'tier_balanced',l:'Balanced — Qwen3B-VL + whisper-medium (8GB)'},
  {v:'tier_minimal',l:'Minimal — Qwen3B-VL + whisper-small (6GB)'}];
let libfiles=[];

function esc(s){return (s??'').toString().replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function fmtDur(s){if(s==null)return'—';s=Math.round(s);const h=Math.floor(s/3600),m=Math.floor(s%3600/60);return(h?h+'h ':'')+m+'m'}
function fmtSize(b){if(b==null)return'—';if(b>1e9)return(b/1e9).toFixed(1)+' GB';if(b>1e6)return(b/1e6).toFixed(0)+' MB';return(b/1e3).toFixed(0)+' KB'}

async function pollAll(){
  try{
    const d=await(await fetch('/api/admin/queue')).json();
    document.getElementById('wstate').innerHTML =
      `<span class="badge${d.worker.paused?' warn':''}">${d.worker.paused?'PAUSED':'RUNNING'}</span> `+
      (d.worker.model?`GPU: <code>${esc(d.worker.model)}</code>`:'GPU idle');
    document.getElementById('qbody').innerHTML = d.queue.length?d.queue.map(j=>{
      const stages=(j.events||[]).map(e=>
        `<span class="st-${e.status==='done'?'done':e.status==='failed'?'failed':'active'}">${esc(e.stage)}:${e.status}</span>`).join(' ');
      const err=(j.events||[]).filter(e=>e.err).map(e=>`<pre>${esc(e.err.slice(-300))}</pre>`).join('');
      return `<tr><td>${j.queue_id}</td><td><code>${esc(j.code)}</code></td><td>${j.priority}</td>
        <td class="st-${j.status==='done'?'done':j.status==='failed'?'failed':'active'}">${j.status}</td>
        <td>${stages||'<span style="color:var(--fg-dim)">none</span>'}${err}</td>
        <td>${j.status==='failed'?`<button class="tiny" onclick="retry(${j.queue_id})">Retry</button>`:''}</td></tr>`;
    }).join(''):'<tr><td colspan="6" style="color:var(--fg-dim)">Queue empty.</td></tr>';
  }catch(e){document.getElementById('wstate').innerHTML='<span class="badge warn">API unreachable</span>'}
}

async function pollStats(){
  try{
    const s=await(await fetch('/api/admin/stats')).json();
    document.getElementById('stat-files').textContent=s.files;
    document.getElementById('stat-shots').textContent=s.shots;
    document.getElementById('stat-utter').textContent=s.utterances;
    document.getElementById('stat-scenes').textContent=s.scenes;
    document.getElementById('stat-queue').textContent=s.pending;
    document.getElementById('stat-failed').textContent=s.failed;
    document.getElementById('stat-extra').innerHTML=`Source volume: <b>${fmtSize(s.source_bytes)}</b> · corrections: ${s.corrections} · active jobs: ${s.active}`;
    const moods=(s.top_moods||[]).map(m=>`<span class="pill">${esc(m.mood)} ${m.n}</span>`).join('');
    const moves=(s.top_movements||[]).map(m=>`<span class="pill">${esc(m.movement)} ${m.n}</span>`).join('');
    document.getElementById('stat-top').innerHTML=(moods?`<div style="font-size:10px;color:var(--fg-dim);text-transform:uppercase">Top moods</div>${moods}`:'')+(moves?`<div style="font-size:10px;color:var(--fg-dim);text-transform:uppercase;margin-top:6px">Top camera moves</div>${moves}`:'');
  }catch(e){}
}

async function pollLibrary(){
  try{
    const d=await(await fetch('/api/admin/library')).json();
    libfiles=d.files;renderLibrary(document.getElementById('libfilter').value);
  }catch(e){}
}
function renderLibrary(f){
  f=(f||'').toLowerCase();
  const rows=libfiles.filter(x=>!f||x.code.toLowerCase().includes(f)||x.path.toLowerCase().includes(f));
  document.getElementById('libbody').innerHTML=rows.length?rows.map(x=>`<tr>
    <td><code>${esc(x.code)}</code></td><td style="font-size:11px;font-family:monospace;color:var(--fg-dim)">${esc(x.path)}</td>
    <td class="st-${x.status==='done'?'done':x.status==='failed'?'failed':'active'}">${x.status}</td>
    <td>${fmtDur(x.duration_s)}</td><td>${fmtSize(x.size_bytes)}</td><td>${x.shots}</td><td>${x.utterances}</td>
    <td><button class="tiny ghost" onclick="delFile(${x.file_id},'${esc(x.code)}')">Remove</button></td></tr>`).join('')
    :'<tr><td colspan="8" style="color:var(--fg-dim)">No files indexed yet.</td></tr>';
}
async function delFile(id,code){
  if(!confirm(`Remove ${code} from the library DB (keeps the source file on disk)?`))return;
  const r=await fetch(`/api/admin/library/${id}/delete`,{method:'POST'});
  if(r.ok){pollLibrary();pollStats();pollAll();}else alert('delete failed: '+r.status);
}

async function pollSchemes(){
  try{
    const d=await(await fetch('/api/admin/schemes')).json();
    document.getElementById('schbody').innerHTML=d.schemes.map(s=>`<tr>
      <td><b>${esc(s.name)}</b>${s.default?' <span class="badge">default</span>':''}</td><td><code>${esc(s.prefix)}</code></td>
      <td>${s.pad}</td><td>${s.next}</td><td>${s.rename?'yes':'no'}</td>
      <td>${s.default?'—':`<button class="tiny ghost" onclick="setDefault('${esc(s.name)}')">make default</button>`}</td>
      <td><button class="tiny ghost" onclick="resetCounter('${esc(s.name)}',${s.pad},'${esc(s.prefix)}',${s.rename})">reset counter</button></td></tr>`).join('')
      ||'<tr><td colspan="7" style="color:var(--fg-dim)">No schemes.</td></tr>';
  }catch(e){}
}
async function setDefault(name){await fetch(`/api/admin/schemes?name=${encodeURIComponent(name)}&set_default=true`,{method:'POST'});pollSchemes();}
async function resetCounter(name,pad,prefix,rename){await fetch(`/api/admin/schemes?name=${encodeURIComponent(name)}&prefix=${prefix}&pad=${pad}&next=1&rename=${rename}`,{method:'POST'});pollSchemes();}
async function addScheme(){
  const n=document.getElementById('sname').value.trim(),p=document.getElementById('sprefix').value.trim()||'SPOT';
  if(!n)return;
  await fetch(`/api/admin/schemes?name=${encodeURIComponent(n)}&prefix=${p}`,{method:'POST'});
  document.getElementById('sname').value='';pollSchemes();
}

async function setTier(t){
  const r=await fetch('/api/admin/config',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({tier:t})});
  document.getElementById('mtmsg').textContent=r.ok?'Saved — applies to the next job':'error';
}
async function setResidency(p){
  const r=await fetch('/api/admin/config',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({residency:p})});
  document.getElementById('resmsg').textContent=r.ok?'Saved — worker picks it up on its next poll (≤5s)':'error';
}
function retry(id){fetch(`/api/admin/retry/${id}`,{method:'POST'}).then(()=>pollAll());}
function pauseWorker(p){fetch('/api/admin/pause?paused='+p,{method:'POST'}).then(()=>pollAll());}

async function initControls(){
  const t=await(await fetch('/api/admin/config')).json().catch(()=>({tier:'tier_full',residency:'sequential'}));
  document.getElementById('mtier').innerHTML=tiers.map(x=>`<option value="${x.v}">${x.l}</option>`).join('');
  document.getElementById('mtier').value=t.tier||'tier_full';
  const r=await(await fetch('/api/admin/residency')).json().catch(()=>({profiles:{sequential:{label:'Sequential (12GB)'}}}));
  document.getElementById('residency').innerHTML=Object.entries(r.profiles).map(([k,v])=>
    `<option value="${k}">${v.label}</option>`).join('');
  document.getElementById('residency').value=r.current||'sequential';
}

initControls();pollAll();pollStats();pollLibrary();pollSchemes();
setInterval(()=>{pollAll();pollStats();},5000);
setInterval(()=>{pollLibrary();pollSchemes();},15000);
</script>
</body></html>
