<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>CineSearch — Cinematic Search</title>
<script src="https://unpkg.com/htmx.org@2.0.4"></script>
<script src="https://cdn.jsdelivr.net/npm/hls.js@1"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap');
:root{--v:#8b3dff;--violet:#a060ff;--pink:#ff4ec8;--bg:#0a0514;--surface:#120a20;--line:#2a1a38;--fg:#f3e8ff;--fg-dim:#b08dc8;--bad:#ff5c8a;--ok:#5ad18a}
*{box-sizing:border-box}
body{margin:0;background:linear-gradient(180deg,#0a0514 0%,#14082a 60%,#120a20 100%);min-height:100vh;color:var(--fg);font:14px/1.6 Inter,system-ui,sans-serif}
h1{font-size:20px;font-weight:800;color:var(--pink);letter-spacing:-.03em;text-shadow:0 0 30px rgba(255,78,200,.35);margin:0;white-space:nowrap}
.subtitle{font-size:10px;color:var(--violet);letter-spacing:.15em;text-transform:uppercase;font-weight:400}
#bar{position:sticky;top:0;background:rgba(10,5,20,.85);backdrop-filter:blur(12px);padding:14px 20px;display:flex;gap:10px;align-items:center;z-index:10;border-bottom:1px solid rgba(255,255,255,.06);box-shadow:0 6px 30px rgba(139,61,255,.15)}
input,select{background:#0f0518;border:1px solid #3a2055;color:#fff;border-radius:10px;padding:8px 12px;font:inherit;transition:.15s}
input:focus,select:focus{outline:none;border-color:var(--pink);box-shadow:0 0 0 3px rgba(255,78,200,.15)}
#q{flex:1;font-size:15px}
.btn{cursor:pointer;border:0;border-radius:10px;padding:9px 16px;font:600 13px Inter,sans-serif;background:linear-gradient(135deg,#8b3dff,#ff4ec8);color:#fff;box-shadow:0 4px 20px rgba(139,61,255,.35);transition:.15s}
.btn:hover{box-shadow:0 6px 30px rgba(255,78,200,.5);transform:translateY(-1px)}
.btn.ghost{background:transparent;color:var(--violet);border:1px solid #3a2055;box-shadow:none}
.btn.ghost:hover{border-color:var(--pink);color:var(--pink)}
#layout{display:grid;grid-template-columns:400px 1fr;height:calc(100vh-62px)}
#results{overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:12px}
.card{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:12px;cursor:pointer;transition:.15s;box-shadow:0 4px 20px rgba(0,0,0,.3),inset 0 1px 0 rgba(255,255,255,.05)}
.card:hover{border-color:var(--violet);box-shadow:0 0 0 1px rgba(160,96,255,.35),0 8px 30px rgba(139,61,255,.25)}
.card img{width:100%;border-radius:8px;aspect-ratio:16/9;object-fit:cover;background:#000;border:1px solid #241238}
.code{font-weight:700;color:var(--pink);font-size:13px;letter-spacing:.02em;font-variant-numeric:tabular-nums}
.tags{color:var(--fg-dim);font-size:12px;margin-top:6px;line-height:1.35}
.tag-pill{display:inline-block;background:rgba(139,61,255,.12);border:1px solid rgba(139,61,255,.3);color:var(--violet);border-radius:20px;padding:1px 8px;font-size:10px;font-weight:600;margin:3px 4px 0 0}
#player{padding:20px;overflow-y:auto;border-left:1px solid rgba(255,255,255,.06);background:rgba(5,3,10,.5)}
video{width:100%;max-height:55vh;background:#000;border-radius:12px;border:1px solid #241238;box-shadow:0 8px 40px rgba(139,61,255,.2)}
#tl{position:relative;height:80px;margin-top:16px;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:#0f0518}
#tl img{position:absolute;inset:0;width:100%;height:100%;opacity:.4}
.blk{position:absolute;top:0;height:100%;border-right:1px solid rgba(255,255,255,.05);background:rgba(160,96,255,.1)}
.blk:hover{background:rgba(160,96,255,.3)}
.blk.sel{background:rgba(255,78,200,.3);outline:2px solid var(--pink)}
#ph{position:absolute;top:0;width:2px;height:100%;background:var(--pink);box-shadow:0 0 10px var(--pink);z-index:2;pointer-events:none}
#tr{margin-top:16px;font-size:13px}
.ut{padding:6px 10px;border-radius:8px;cursor:pointer;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.06);margin-bottom:6px;transition:.1s;color:var(--fg-dim)}
.ut:hover{border-color:var(--violet);color:var(--fg)}
.ut.on{border-color:var(--pink);color:var(--fg);background:rgba(255,78,200,.08)}
.row{display:flex;gap:10px;margin-top:14px;align-items:center;flex-wrap:wrap}
</style></head><body>
<div id="bar">
  <h1>CineSearch <span class="subtitle">SEARCH</span></h1>
  <input id="q" placeholder="Search: 'dolly-in hero', 'whispered tension'…"
    hx-get="/api/search_ui" hx-trigger="keyup changed delay:500ms, search" hx-target="#results"
    hx-include="#filters" name="q">
  <span id="filters">
    <select name="camera_movement" hx-get="/api/search_ui" hx-trigger="change" hx-target="#results" hx-include="#q"><option value="">movement…</option><option>static</option><option>pan</option><option>tilt</option><option>dolly_in</option><option>dolly_out</option><option>tracking</option><option>handheld</option><option>steadicam</option><option>crane</option><option>arc</option></select>
    <select name="shot_size" hx-get="/api/search_ui" hx-trigger="change" hx-target="#results" hx-include="#q"><option value="">size…</option><option>extreme_wide</option><option>wide</option><option>medium</option><option>medium_close_up</option><option>close_up</option><option>extreme_close_up</option></select>
    <select name="mood" hx-get="/api/search_ui" hx-trigger="change" hx-target="#results" hx-include="#q"><option value="">mood…</option><option>tense</option><option>melancholic</option><option>hopeful</option><option>eerie</option><option>joyful</option></select>
  </span>
  <button class="btn" onclick="document.getElementById('q').dispatchEvent(new Event('search'))">Search</button>
  <button class="btn ghost" onclick="location='/admin/'">Admin</button>
</div>
<div id="layout">
  <div id="results" hx-get="/api/search_ui" hx-trigger="load"></div>
  <div id="player"><p style="color:var(--fg-dim)">Select a shot to view timeline, transcript, and file ID.</p></div>
</div>
<script>
async function openShot(id){
  const c=await(await fetch(`/api/shot/${id}/context`)).json();
  const p=document.getElementById('player');
  const dur=Math.max(...c.shots.map(s=>s.b),1);
  p.innerHTML=`
    <video id="v" controls></video>
    <div id="tl"><img src="${c.waveform}" onerror="this.remove()">
      ${c.shots.map(s=>`<div class="blk ${s.id==id?'sel':''}" style="left:${s.a/dur*100}%;width:${(s.b-s.a)/dur*100}%" title="${s.size||''} ${s.mv||''}" onclick="seek(${s.a})"></div>`).join('')}
      <div id="ph"></div>
    </div>
    <div class="row">
      <button class="btn" onclick="copyCode('${c.code||''}')">Copy ID + TC</button>
      <span id="cc" class="code"></span>
      <span style="color:var(--fg-dim);font-size:11px;margin-left:auto">File: <span class="code">${c.file_rel||'—'}</span></span>
    </div>
    <div id="tr">${c.utterances.map(u=>`<div class="ut" data-a="${u.a}" data-b="${u.b}" onclick="seek(${u.a})">[${fmt(u.a)}] <b>${u.spk||'—'}</b> ${u.text}</div>`).join('')}</div>`;
  const v=document.getElementById('v');
  if(Hls.isSupported()){const h=new Hls();h.loadSource(c.proxy);h.attachMedia(v);}
  else v.src=c.proxy;
  v.addEventListener('loadedmetadata',()=>v.currentTime=c.shot_tc[0]);
  v.addEventListener('timeupdate',()=>{
    document.getElementById('ph').style.left=(v.currentTime/dur*100)+'%';
    document.querySelectorAll('.ut').forEach(e=>e.classList.toggle('on',v.currentTime>=+e.dataset.a&&v.currentTime<+e.dataset.b));
  });
}
function seek(t){const v=document.getElementById('v');v.currentTime=t;v.play();}
function copyCode(c){navigator.clipboard.writeText(c);document.getElementById('cc').textContent='copied: '+c;}
function fmt(s){const h=String(Math.floor(s/3600)).padStart(2,'0'),m=String(Math.floor(s%3600/60)).padStart(2,'0'),x=(s%60).toFixed(2).padStart(5,'0');return`${h}:${m}:${x}`;}
</script>
</body></html>
